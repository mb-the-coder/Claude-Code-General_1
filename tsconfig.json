{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/api/base44Client": ["./dev/stubs/base44Client.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "backend/**/*.ts",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "pages/**/*.tsx",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "dev/**/*.ts",
    "dev/**/*.tsx"
  ]
}
